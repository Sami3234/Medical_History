name = "medical-history-temporary-share"
main = "src/index.js"
compatibility_date = "2026-10-01"

[[r2_buckets]]
binding = "TEMPORARY_SHARES"
bucket_name = "medical-history-temporary-shares"

[[kv_namespaces]]
binding = "RATE_LIMITS"
id = "REPLACE_WITH_KV_NAMESPACE_ID"
preview_id = "REPLACE_WITH_PREVIEW_KV_NAMESPACE_ID"

[vars]
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
ALLOWED_ORIGIN = ""

# Add these with wrangler secret put:
# SUPABASE_ANON_KEY
# OTP_PEPPER
