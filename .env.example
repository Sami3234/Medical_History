# Copy to .env.local and provide local values. Never commit .env.local.
# Complete inventory of external APIs currently used by this project.

# Supabase: Flutter and admin panel
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_ANON_KEY

# Cloudinary: Flutter and admin panel
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_PUBLIC_API_KEY
CLOUDINARY_UPLOAD_PRESET=YOUR_UNSIGNED_UPLOAD_PRESET

# Google OAuth: Flutter sign-in
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Cloudflare temporary sharing
TEMP_SHARE_API_URL=https://YOUR_WORKER.workers.dev
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=medical-history-temporary-shares

# Prefer wrangler login; keep production secrets in Cloudflare.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
OTP_PEPPER=
